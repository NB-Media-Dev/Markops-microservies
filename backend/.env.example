# ==============================================================================
# MarkOps Microservices Architecture - Environment Configuration
# ==============================================================================

# API Gateway Configuration
PORT=4000
API_GATEWAY_PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=markops_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=markops_refresh_secret_super_secure_key_67890

# Downstream Microservices URLs (Consumed by API Gateway)
AUTH_SERVICE_URL=http://localhost:4001
CAMPAIGN_SERVICE_URL=http://localhost:4002
CREATIVE_TASK_SERVICE_URL=http://localhost:4003
LEAD_SERVICE_URL=http://localhost:4004
CONVERSION_SERVICE_URL=http://localhost:4003
REALTIME_SERVICE_URL=http://localhost:4006
REPORTING_SERVICE_URL=http://localhost:4007

# Downstream Microservices Ports
AUTH_SERVICE_PORT=4001
CAMPAIGN_SERVICE_PORT=4002
CREATIVE_TASK_SERVICE_PORT=4003
LEAD_SERVICE_PORT=4004
REALTIME_SERVICE_PORT=4006
REPORTING_SERVICE_PORT=4007

# Microfrontend Client URLs
FRONTEND_URL=http://localhost:4200
CLIENT_URL=http://localhost:4200
SHELL_URL=http://localhost:4200
LOGIN_URL=http://localhost:4201
DESIGNER_URL=http://localhost:4202

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3303
DB_USER=root
