{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api-gateway",
    "auth-service",
    "campaign-service",
    "creative-task-service",
    "lead-service",
    "realtime-service",
    "reporting-service",
    "shared"
  ],
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:gateway": "npm start --workspace=api-gateway",
    "start:auth": "npm start --workspace=auth-service",
    "start:campaign": "npm start --workspace=campaign-service",
    "start:creative": "npm start --workspace=creative-task-service",
    "start:lead": "npm start --workspace=lead-service",
    "start:realtime": "npm start --workspace=realtime-service",
    "start:reporting": "npm start --workspace=reporting-service",
    "dev:gateway": "npm --workspace=api-gateway run dev",
    "dev:auth": "npm --workspace=auth-service run dev",
    "dev": "concurrently -n \"gateway,auth\" -c \"cyan,magenta\" \"npm run dev:gateway\" \"npm run dev:auth\"",
    "dev:all": "concurrently -n \"gateway,auth,campaign,creative,lead,realtime,reporting\" \"npm run dev:gateway\" \"npm run dev:auth\" \"npm --workspace=campaign-service run dev\" \"npm --workspace=creative-task-service run dev\" \"npm --workspace=lead-service run dev\" \"npm --workspace=realtime-service run dev\" \"npm --workspace=reporting-service run dev\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^8.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}